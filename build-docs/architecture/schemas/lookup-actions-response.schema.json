{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cite2site.local/schemas/0.3/lookup-actions-response.schema.json",
  "title": "Lookup Actions Response",
  "type": "object",
  "required": ["ok", "matches"],
  "additionalProperties": true,
  "properties": {
    "ok": {"const": true},
    "requires_picker": {"type": "boolean"},
    "actions": {"type": "array", "items": {"type": "string"}},
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["citation_id", "match_kind", "range_summary", "status", "actions"],
        "additionalProperties": false,
        "properties": {
          "citation_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "preferred_handle": {"type": ["string", "null"]},
          "match_kind": {"enum": ["exact", "contains", "contained_by", "overlaps"]},
          "range_summary": {"type": "string"},
          "status": {"enum": ["resolved", "changed", "missing", "ambiguous", "adapter_unavailable", "private", "unsupported", "retracted"]},
          "actions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
