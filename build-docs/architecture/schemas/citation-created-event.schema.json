{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cite2site.local/schemas/0.3/citation-created-event.schema.json",
  "title": "Citation Created Event",
  "allOf": [
    {"$ref": "event-envelope.schema.json"},
    {
      "type": "object",
      "required": ["citation_id", "artifact", "locator", "accepted_evidence", "metadata"],
      "properties": {
        "event_type": {"const": "citation.created"},
        "citation_id": {"$ref": "#/$defs/hash"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "locator": {"$ref": "#/$defs/text_range"},
        "accepted_evidence": {"$ref": "#/$defs/evidence"},
        "metadata": {
          "type": "object",
          "required": ["tags"],
          "additionalProperties": true,
          "properties": {
            "label": {"type": ["string", "null"]},
            "tags": {"type": "array", "items": {"type": "string"}},
            "note": {"type": ["string", "null"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["adapter", "uri", "artifact_id"],
      "additionalProperties": false,
      "properties": {
        "adapter": {"enum": ["filesystem-text", "markdown"]},
        "uri": {"type": "string"},
        "artifact_id": {"$ref": "#/$defs/hash"}
      }
    },
    "text_range": {
      "type": "object",
      "required": ["kind", "encoding", "start", "end", "start_line", "end_line"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "text-range"},
        "encoding": {"const": "unicode-scalar"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "canonicalization", "content_hash", "line_hashes", "byte_count", "line_count"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "text"},
        "canonicalization": {"const": "text-utf8-lf-v1"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "text": {"type": "string"},
        "line_hashes": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
        "byte_count": {"type": "integer", "minimum": 0},
        "line_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
