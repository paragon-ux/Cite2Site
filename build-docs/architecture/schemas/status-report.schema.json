{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cite2site.local/schemas/0.3/status-report.schema.json",
  "title": "Status Report",
  "type": "object",
  "required": ["ok", "schema_version", "repository_id", "privacy_mode", "citations", "indexes", "summary"],
  "additionalProperties": true,
  "properties": {
    "ok": {"const": true},
    "schema_version": {"const": "c2s.status.v0.3"},
    "repository_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "privacy_mode": {"enum": ["metadata_only", "hash_only", "snippet", "private_link"]},
    "citations": {"type": "array"},
    "indexes": {"type": "object"},
    "summary": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
