{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cite2site.local/schemas/0.3/workflow-citation-event.schema.json",
  "title": "Citation Workflow Event",
  "type": "object",
  "required": ["schema_version", "event_type", "event_id", "previous_event_hash", "repository_id", "created_at", "actor", "tool", "citation_id"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "c2s.event.v0.3"},
    "event_type": {"enum": ["citation.accepted", "citation.retracted", "citation.restored", "citation.relocated", "citation.noted"]},
    "event_id": {"$ref": "#/$defs/hash"},
    "previous_event_hash": {"$ref": "#/$defs/hash"},
    "repository_id": {"$ref": "#/$defs/hash"},
    "citation_id": {"$ref": "#/$defs/hash"},
    "accepted_evidence": {"type": "object"},
    "artifact": {"type": "object"},
    "locator": {"type": "object"},
    "observed_content_hash": {"$ref": "#/$defs/hash"},
    "note": {"type": "string"},
    "created_at": {"type": "string"},
    "actor": {"type": "object"},
    "tool": {"type": "object"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
