{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cite2site.local/schemas/0.3/handle-bound-event.schema.json",
  "title": "Handle Bound Event",
  "allOf": [
    {"$ref": "event-envelope.schema.json"},
    {
      "type": "object",
      "required": ["citation_id", "handle", "action", "policy"],
      "properties": {
        "event_type": {"const": "handle.bound"},
        "citation_id": {"$ref": "#/$defs/hash"},
        "handle": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"},
        "action": {"enum": ["bind", "rename", "alias", "retire"]},
        "previous_handle": {"type": ["string", "null"]},
        "policy": {
          "type": "object",
          "required": ["preserve_previous_as_alias"],
          "additionalProperties": false,
          "properties": {
            "preserve_previous_as_alias": {"type": "boolean"}
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
