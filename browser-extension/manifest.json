{
  "manifest_version": 3,
  "name": "Cite2Site",
  "version": "2.0.0",
  "description": "Replacement-protocol source-clean citations with groups, handles, and idempotency.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cite2Site"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
